[Unit]
Description=Axon Matrix Docker stack
Documentation=file:/opt/axon/docs/operations/LINUX_OPERATIONS.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=AXON_ROOT=/opt/axon
Environment=AXON_CONFIG_ROOT=/etc/axon
ExecStartPre=/opt/axon/installer/linux/configure-firewall.sh
ExecStart=/usr/bin/docker compose --project-name axon --env-file /etc/axon/.env --file /opt/axon/deploy/compose.yaml up --detach --wait --wait-timeout 300
ExecStop=/usr/bin/docker compose --project-name axon --env-file /etc/axon/.env --file /opt/axon/deploy/compose.yaml stop
TimeoutStartSec=600
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
